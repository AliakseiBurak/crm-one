# --- Порты хоста ---
HTTPS_PORT=443
MYSQL_PORT=3306
MAILPIT_UI_PORT=8025
PMA_PORT=8080

# --- БД ---
MYSQL_DATABASE=b2b_crm
MYSQL_USER=b2b_crm
MYSQL_PASSWORD=b2b_crm_dev_password
MYSQL_ROOT_PASSWORD=b2b_crm_root_password
DATABASE_URL=mysql://b2b_crm:b2b_crm_dev_password@mysql:3306/b2b_crm?serverVersion=8.4

# --- Mailer (dev: Mailpit внутри сети compose) ---
MAILER_DSN=smtp://mailpit:1025

# --- Приложение ---
APP_SECRET=dev_b2b_crm_change_me

RUN_MIGRATIONS=1
ENABLE_FIXTURES=1

# Абсолютный URI для URL в CLI (tracking-pixel в письмах).
DEFAULT_URI=https://b2b-crm.local

# --- Mailing ---
MAILING_BATCH_SIZE=10
MAILING_FROM_EMAIL=user@b2b-crm.local
MAILING_FROM_NAME="B2B Call CRM"

# --- Журнал отправки писем ---
# Каталог файлов журнала отправки (mailer-YYYY-MM.log, mailer-YYYY.zip).
# По умолчанию var/log; задавайте, если каталог размещается вне var/log.
MAILER_LOG_DIR=

# --- Xdebug ---
XDEBUG_MODE=debug

# --- Git ---
GIT_AUTHOR_NAME="Developer"
GIT_AUTHOR_EMAIL="dev@b2b-crm.loc"

# --- E2E ---
# URL по умолчанию для сервиса e2e (внутри сети compose резолвится b2b-crm.local).
# Для запуска из контейнера OpenCode: BASE_URL=https://host.docker.internal
BASE_URL=https://b2b-crm.local
