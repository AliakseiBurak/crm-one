{#
    Состав группы (change organization-groups).
    canEdit=true: чекбоксы для добавления/удаления организаций из группы.
    canEdit=false: только просмотр состава (назначенная группа — право
    изменения остаётся у создателя или администратора).
    Ожидает: group (OrganizationGroup), canEdit (bool), organizations (Organization[]),
    members (Organization[]), memberIds (int[]), sort (string), dir (string).
#}
{% extends 'base.html.twig' %}

{% block title %}Состав группы «{{ group.name }}»{% endblock %}

{% macro sort_url(route, params, field, currentSort, currentDir) -%}
    {{ path(route, params|merge({ sort: field, dir: currentSort == field and currentDir == 'ASC' ? 'DESC' : 'ASC' })) }}
{%- endmacro %}

{% macro sort_header(route, params, label, field, currentSort, currentDir) -%}
    {% if currentSort == field %}
        <a class="table__sortable table__sortable--active" href="{{ _self.sort_url(route, params, field, currentSort, currentDir) }}">
            {{ label }}{{ currentDir == 'DESC' ? ' ↓' : ' ↑' }}
        </a>
    {% else %}
        <a class="table__sortable" href="{{ _self.sort_url(route, params, field, currentSort, currentDir) }}">{{ label }}</a>
    {% endif %}
{%- endmacro %}

{% block body %}
    <section class="section section--white">
        <div class="container">
            <h1>Состав группы «{{ group.name }}»</h1>

            {% if not canEdit %}
                <p class="group-members__readonly">
                    Группа назначена вам администратором: состав доступен только на просмотр,
                    изменение доступно её создателю или администратору.
                </p>

                {% if members is not empty %}
                    <div class="table-wrap">
                    <table class="table table--org" style="margin-top: 24px;">
                        <thead>
                            <tr>
                                <th class="table--org__name">{{ _self.sort_header('app_group_members', {id: group.id}, 'Название', 'name', sort, dir) }}</th>
                                <th>{{ _self.sort_header('app_group_members', {id: group.id}, 'Отрасль', 'industry', sort, dir) }}</th>
                                <th>{{ _self.sort_header('app_group_members', {id: group.id}, 'Дата создания', 'createdAt', sort, dir) }}</th>
                                <th>{{ _self.sort_header('app_group_members', {id: group.id}, 'Создатель', 'creator', sort, dir) }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for org in members %}
                                <tr data-member-row>
                                    <td class="table--org__name">{{ org.name }}</td>
                                    <td>{{ org.industry|default('—') }}</td>
                                    <td>{{ org.createdAt|date('d.m.Y') }}</td>
                                    <td>
                                        {% if org.createdBy %}
                                            {% set creatorName = (org.createdBy.name|default('') ~ ' ' ~ org.createdBy.surname|default(''))|trim %}
                                            {{ creatorName ?: org.createdBy.email }}
                                        {% else %}
                                            —
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                    </div>
                {% else %}
                    <p>В группе пока нет организаций.</p>
                {% endif %}

                <div style="margin-top: 24px;">
                    {{ include('components/button.html.twig', {
                        variant: 'secondary',
                        text: 'К списку групп',
                        href: path('app_group_list'),
                    }) }}
                </div>
            {% else %}
                <form
                    method="post"
                    action="{{ path('app_group_update_members', { id: group.id }) }}"
                    class="group-members-form"
                    style="margin-top: 24px;"
                >
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('group') }}">

                    {% if organizations is not empty %}
                        <div class="table-wrap">
                        <table class="table table--org">
                            <thead>
                                <tr>
                                    <th><input type="checkbox" id="select-all"></th>
                                    <th class="table--org__name">{{ _self.sort_header('app_group_members', {id: group.id}, 'Название', 'name', sort, dir) }}</th>
                                    <th>{{ _self.sort_header('app_group_members', {id: group.id}, 'Отрасль', 'industry', sort, dir) }}</th>
                                    <th>{{ _self.sort_header('app_group_members', {id: group.id}, 'Дата создания', 'createdAt', sort, dir) }}</th>
                                    <th>{{ _self.sort_header('app_group_members', {id: group.id}, 'Создатель', 'creator', sort, dir) }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for org in organizations %}
                                    <tr>
                                        <td>
                                            <input
                                                type="checkbox"
                                                name="organizations[]"
                                                value="{{ org.id }}"
                                                {% if org.id in memberIds %}checked{% endif %}
                                            >
                                        </td>
                                        <td class="table--org__name">{{ org.name }}</td>
                                        <td>{{ org.industry|default('—') }}</td>
                                        <td>{{ org.createdAt|date('d.m.Y') }}</td>
                                        <td>
                                            {% if org.createdBy %}
                                                {% set creatorName = (org.createdBy.name|default('') ~ ' ' ~ org.createdBy.surname|default(''))|trim %}
                                                {{ creatorName ?: org.createdBy.email }}
                                            {% else %}
                                                —
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                        </div>
                    {% else %}
                        <p>Нет доступных организаций.</p>
                    {% endif %}

                    <div class="group-form__members-row" style="margin-top: 24px;">
                        {{ include('components/button.html.twig', {
                            variant: 'secondary',
                            text: 'Редактировать',
                            href: path('app_group_edit', { id: group.id }),
                            type: 'button',
                        }) }}
                        {{ include('components/button.html.twig', {
                            variant: 'secondary',
                            text: 'Назначить менеджеров',
                            href: path('app_group_assign', { id: group.id }),
                            type: 'button',
                        }) }}
                    </div>

                    <div class="group-members-form__actions" style="margin-top: 24px;">
                        {{ include('components/button.html.twig', {
                            variant: 'primary',
                            text: 'Сохранить',
                        }) }}
                        {{ include('components/button.html.twig', {
                            variant: 'secondary',
                            text: 'Отмена',
                            href: path('app_group_list'),
                            type: 'button',
                        }) }}
                    </div>
                </form>

                <script>
                    document.getElementById('select-all')?.addEventListener('change', function() {
                        document.querySelectorAll('input[name="organizations[]"]').forEach(cb => {
                            cb.checked = this.checked;
                        });
                    });
                </script>
            {% endif %}
        </div>
    </section>
{% endblock %}
