{#
    Список групп менеджера (change organization-groups,
    organizations-pagination): сортировка выполняется в SQL, постраничного
    вывода нет — у компании десятки собственных групп, а блок навигации здесь
    не окупает ни одного своего недостатка.
    Ожидает: groups (OrganizationGroup[]), manageableIds (int[]|null) — null
    означает доступ на изменение для всех групп (администратор), sort (string),
    direction (string).
#}
{% extends 'base.html.twig' %}

{% block title %}{% if is_granted('ROLE_ADMIN') %}Группы{% else %}Мои группы{% endif %}{% endblock %}

{% macro sort_url(route, field, currentSort, currentDir) -%}
    {{ path(route, { sort: field, dir: currentSort == field and currentDir == 'ASC' ? 'DESC' : 'ASC' }) }}
{%- endmacro %}

{% macro sort_header(route, label, field, currentSort, currentDir) -%}
    {% if currentSort == field %}
        <a class="table__sortable table__sortable--active" href="{{ _self.sort_url(route, field, currentSort, currentDir) }}">
            {{ label }}{{ currentDir == 'DESC' ? ' ↓' : ' ↑' }}
        </a>
    {% else %}
        <a class="table__sortable" href="{{ _self.sort_url(route, field, currentSort, currentDir) }}">{{ label }}</a>
    {% endif %}
{%- endmacro %}

{% block body %}
    <section class="section section--white">
        <div class="container">
            <h1>{% if is_granted('ROLE_ADMIN') %}Группы{% else %}Мои группы{% endif %}</h1>

            <div class="group-list__actions" style="margin-bottom: 24px;">
                {{ include('components/button.html.twig', {
                    variant: 'primary',
                    text: 'Новая группа',
                    href: path('app_group_new'),
                    sm: true,
                }) }}
            </div>

            {% if groups is not empty %}
                <table class="table">
                    <thead>
                        <tr>
                            <th>{{ _self.sort_header('app_group_list', 'Название', 'name', sort, direction) }}</th>
                            <th>Цвет</th>
                            <th>Описание</th>
                            <th>{{ _self.sort_header('app_group_list', 'Создатель', 'creator', sort, direction) }}</th>
                            <th style="white-space:nowrap"></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for group in groups %}
                            <tr data-group-row>
                                <td>{{ group.name }}</td>
                                <td>
                                    {% if group.color %}
                                        <span style="display:inline-block;width:20px;height:20px;background-color:{{ group.color }};border-radius:4px;vertical-align:middle;"></span>
                                    {% else %}
                                        —
                                    {% endif %}
                                </td>
                                <td>{{ group.description|default('—') }}</td>
                                <td>
                                    {% if group.createdBy %}
                                        {% set creatorFullName = (group.createdBy.name|default('') ~ ' ' ~ group.createdBy.surname|default(''))|trim %}
                                        {{ creatorFullName ?: group.createdBy.email }}
                                    {% else %}
                                        —
                                    {% endif %}
                                </td>
                                <td style="white-space:nowrap">
                                    {% if manageableIds is null or group.id in manageableIds %}
                                        <a href="{{ path('app_group_edit', { id: group.id }) }}" class="btn btn--secondary btn--sm">Редактировать</a>
                                        <a href="{{ path('app_group_members', { id: group.id }) }}" class="btn btn--secondary btn--sm">Состав</a>
                                    {% else %}
                                        <a href="{{ path('app_group_members', { id: group.id }) }}" class="btn btn--secondary btn--sm">Состав</a>
                                        <span class="group-list__readonly">только просмотр</span>
                                    {% endif %}
                                    {% if is_granted('ROLE_ADMIN') %}
                                        <a href="{{ path('app_group_assign', { id: group.id }) }}" class="btn btn--secondary btn--sm">Назначить менеджеров</a>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% else %}
                <p>Групп нет.</p>
            {% endif %}
        </div>
    </section>
{% endblock %}
