{% extends 'base.html.twig' %}

{% block title %}B2B Call CRM — обзвон, который приводит к договорённостям{% endblock %}

{% block body %}
    <section class="hero" style="background-image: url('{{ asset('images/hero.svg') }}');">
        <div class="hero__inner">
            <h1 class="hero__title">B2B Call CRM — обзвон, который приводит к договорённостям</h1>
            <div class="hero__slogan">Управляйте обзвоном — растите договорённости</div>
            <div class="hero__actions">
                {% include 'components/button.html.twig' with { variant: 'primary', text: 'Начать работу', href: path('app_dashboard') } %}
            </div>
        </div>
    </section>

    {% if app.user %}
        {% set stat_sections = [
            {
                title: 'Сделано звонков',
                modifier: 'called',
                items: [
                    { figure: stats.calledToday, caption: 'Сегодня', bucket: 'called1' },
                    { figure: stats.calledWeek, caption: 'За 7 дней', bucket: 'called7' },
                    { figure: stats.calledMonth, caption: 'За 30 дней', bucket: 'called30' },
                ],
            },
            {
                title: 'Ожидают звонка',
                modifier: 'waiting',
                items: [
                    { figure: stats.waitingToday, caption: 'Сегодня', bucket: 'waiting1' },
                    { figure: stats.waitingWeek, caption: 'За 7 дней', bucket: 'waiting7' },
                    { figure: stats.waitingMonth, caption: 'За 30 дней', bucket: 'waiting30' },
                ],
            },
            {
                title: 'Просроченные звонки',
                modifier: 'overdue',
                items: [
                    { figure: statsByOrg['overdue1'], caption: 'Вчера', bucket: 'overdue1' },
                    { figure: statsByOrg['overdue7'], caption: 'За 7 дней', bucket: 'overdue7' },
                    { figure: statsByOrg['overdue30'], caption: 'За 30 дней', bucket: 'overdue30' },
                ],
            },
            {
                title: 'Отписки организаций',
                modifier: 'optout',
                items: [
                    { figure: optOutStats.optedOutToday, caption: 'сегодня', subFigure: optOutStats.optedOutTodayByEmail, subCaption: 'Из письма', subBucket: 'optoutEmail1' },
                    { figure: optOutStats.optedOutWeek, caption: 'за 7 дней', subFigure: optOutStats.optedOutWeekByEmail, subCaption: 'Из письма', subBucket: 'optoutEmail7' },
                    { figure: optOutStats.optedOutMonth, caption: 'за 30 дней', subFigure: optOutStats.optedOutMonthByEmail, subCaption: 'Из письма', subBucket: 'optoutEmail30' },
                ],
            },
        ] %}

        <section class="stats-home">
            <div class="container">
                <div class="stats__total">Доступно организаций: {{ totalOrgs }}</div>

                <div class="stats-home__grid">
                    {% for section in stat_sections %}
                        <div class="stats-home__section stats-home__section--{{ section.modifier }}">
                            <h2 class="stats-home__title">{{ section.title }}</h2>
                            <div class="stats-home__items">
                                {% for item in section.items %}
                                    <div class="stats__item">
                                        <div class="stats__figure">{{ item.figure }}</div>
                                        <div class="stats__caption">{{ item.caption }}</div>
                                        {% if item.subFigure is defined %}
                                            <a class="stats__sub" href="{{ path('app_dashboard', { filter: item.subBucket }) }}">{{ item.subCaption }}: {{ item.subFigure }}</a>
                                        {% endif %}
                                        {% if item.bucket is defined %}
                                            <a class="stats__orgs" href="{{ path('app_dashboard', { filter: item.bucket }) }}">По организациям: {{ statsByOrg[item.bucket] }}</a>
                                        {% endif %}
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </section>
    {% endif %}
{% endblock %}
