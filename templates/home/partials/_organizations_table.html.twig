{#
    Секция «Организации» панели (change dashboard-orgs-contacts):
    поиск, зебра-таблица с сортировкой, аккордеон контактов и звонков.
    Кнопки «Изменить» карточек контактов и «Добавить контакт» ведут на
    маршруты contacts-crud (модальное окно / форма создания).
    Ожидает: organizationRows (DashboardOrganizationRow[]), contactsByOrganization,
    callsByOrganization, search, sort, dir, highlight.
#}
{% macro sort_url(col, search, sort, dir, highlight) -%}
    {{ path('app_dashboard', { q: search|default(''), sort: col, dir: sort == col and dir == 'asc' ? 'desc' : 'asc' }|merge(highlight ? { highlight: highlight } : {})) }}
{%- endmacro %}

{% macro sort_header(col, label, search, sort, dir, highlight) -%}
    {% if sort == col %}
        <a class="table__sortable table__sortable--active" href="{{ _self.sort_url(col, search, sort, dir, highlight) }}">
            {{ label }}{{ dir == 'desc' ? ' ↓' : ' ↑' }}
        </a>
    {% else %}
        <a class="table__sortable" href="{{ _self.sort_url(col, search, sort, dir, highlight) }}">{{ label }}</a>
    {% endif %}
{%- endmacro %}

<section class="section section--white" id="organizations">
    <div class="container">
        <h2>Организации</h2>

        <form class="org-search" method="get" action="{{ path('app_dashboard') }}">
            <label class="org-search__field">
                <span class="org-search__label">Поиск по названию и контактам</span>
                <input
                    class="org-search__input"
                    type="search"
                    name="q"
                    value="{{ search }}"
                    placeholder="Название организации, имя, телефон или email контакта"
                    autocomplete="off"
                    data-dashboard-search
                >
            </label>
            <button class="btn btn--primary" type="submit">Найти</button>
        </form>

        {% if organizationRows|length == 0 %}
            <p class="org-table__empty">Ничего не найдено</p>
        {% else %}
            <div class="table-wrap">
                <table class="table org-table">
                    <thead>
                        <tr>
                            <th scope="col">{{ _self.sort_header('name', 'Название', search, sort, dir, highlight) }}</th>
                            <th scope="col">{{ _self.sort_header('industry', 'Сфера деятельности', search, sort, dir, highlight) }}</th>
                            <th scope="col">{{ _self.sort_header('lastCall', 'Последний звонок', search, sort, dir, highlight) }}</th>
                            <th scope="col">{{ _self.sort_header('nextCall', 'Следующий звонок', search, sort, dir, highlight) }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in organizationRows %}
                            {% set organization = row.organization %}
                            <tr class="org-table__row{% if highlight == organization.id %} org-table__row--highlight{% endif %}"
                                id="org-{{ organization.id }}"
                                data-organization-row
                                data-org-id="{{ organization.id }}"
                                data-org-name="{{ organization.name }}"
                                data-org-industry="{{ organization.industry }}"
                                data-org-annualplan="{{ organization.annualPlan|default('') }}"
                                data-org-description="{{ organization.description|default('') }}"
                                data-org-hasusedservices="{{ organization.hasUsedServices ? '1' : '0' }}">
                                <td class="org-table__name">
                                    <a class="org-table__name-link" href="{{ path('app_organization_edit', { id: organization.id }) }}"
                                       data-organization-cell="name">{{ organization.name }}</a>
                                    <button class="btn btn--secondary btn--sm org-table__edit" type="button" data-organization-edit>Изменить</button>
                                </td>
                                <td><span data-organization-cell="industry">{{ organization.industry }}</span></td>
                                <td>{{ row.lastMadeAt ? row.lastMadeAt|date('d.m.Y') : '—' }}</td>
                                <td class="org-table__next-call">
                                    {{ row.nextScheduledAt ? row.nextScheduledAt|date('d.m.Y') : '—' }}
                                </td>
                            </tr>
                            <tr class="org-details">
                                <td colspan="4">
                                    <details class="org-details__box"{% if highlight == organization.id %} open{% endif %}>
                                        <summary class="org-details__summary">Звонки и контакты организации</summary>

                                        <a class="btn btn--secondary btn--sm org-calls__add" href="{{ path('app_call_new_org', { organizationId: organization.id }) }}">Добавить звонок</a>

                                        {% set calls = callsByOrganization[organization.id]|default([]) %}
                                        {% set lastCallContact = contactById[row.lastCallContactId]|default(null) %}
                                        {% if row.lastCallNote or calls|length > 0 %}
                                            <div class="org-calls">
                                                {% if row.lastCallNote %}
                                                    <p class="org-calls__last">
                                                        <span class="org-calls__date">Последний звонок{% if row.lastCallDate %}, {{ row.lastCallDate|date('d.m.Y') }}{% endif %}:</span>
                                                        {{ row.lastCallNote }}
                                                        {% if lastCallContact %}
                                                            <span class="org-calls__contact">
                                                                контакт: <em>{{ lastCallContact.name }}</em>
                                                                {% if lastCallContact.phone %}<a href="tel:{{ lastCallContact.phone|default('')|replace({' ': '', '(': '', ')': '', '-': ''}) }}">{{ lastCallContact.phone }}</a>{% endif %}
                                                                {% if lastCallContact.email %}<a href="mailto:{{ lastCallContact.email }}">{{ lastCallContact.email }}</a>{% endif %}
                                                            </span>
                                                        {% endif %}
                                                    </p>
                                                {% endif %}
                                                {% if calls|length > 0 %}
                                                    <details class="org-calls__all">
                                                        <summary class="org-calls__all-summary">Все звонки ({{ calls|length }})</summary>
                                                        <ul class="org-calls__list">
                                                            {% for call in calls %}
                                                                {% include 'call/_row.html.twig' with { callContact: contactById[call.contactId]|default(null) } %}
                                                            {% endfor %}
                                                        </ul>
                                                    </details>
                                                {% endif %}
                                            </div>
                                        {% endif %}

                                        {% set contacts = contactsByOrganization[organization.id]|default([]) %}
                                        <a class="btn btn--secondary btn--sm org-contacts__add" href="{{ path('app_contact_new', { organization: organization.id }) }}" data-contact-create data-org-id="{{ organization.id }}">Добавить контакт</a>
                                        {% if contacts|length > 0 %}
                                            <div class="org-contacts">
                                                {{ include('contact/_grid.html.twig', {
                                                    contacts: contacts,
                                                    bouncedContactIds: bouncedContactIds,
                                                    effectiveMainId: effectiveMainByOrganization[organization.id]|default(null),
                                                }) }}
                                            </div>
                                        {% endif %}
                                    </details>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
</section>