{#
    Форма создания пользователя (change add-new-user).
    Поля: login (обязательное), email (необязательное), name, surname (необязательные), role (обязательное).
    Ожидает: request (CreateUserRequest), errors (array<string, string>).
#}
{% extends 'base.html.twig' %}

{% block title %}Новый пользователь{% endblock %}

{% block body %}
    <section class="section section--white">
        <div class="container">
            <h1>Новый пользователь</h1>

            <form
                class="user-form"
                method="post"
                action="{{ path('app_user_create') }}"
            >
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('user') }}">

                {{ include('components/form_field.html.twig', {
                    name: 'login',
                    type: 'text',
                    label: 'Логин',
                    value: request.login|default(''),
                    error: errors.login|default(null),
                    required: true,
                }) }}

                {{ include('components/form_field.html.twig', {
                    name: 'email',
                    type: 'email',
                    label: 'Email',
                    value: request.email|default(''),
                    error: errors.email|default(null),
                }) }}

                {{ include('components/form_field.html.twig', {
                    name: 'name',
                    label: 'Имя',
                    value: request.name|default(''),
                    error: errors.name|default(null),
                }) }}

                {{ include('components/form_field.html.twig', {
                    name: 'surname',
                    label: 'Фамилия',
                    value: request.surname|default(''),
                    error: errors.surname|default(null),
                }) }}

                <div class="field">
                    <label class="field__label" for="role">Роль</label>
                    <select class="field__input" id="role" name="role" required>
                        <option value="" {% if request.role is not defined or request.role is empty %}selected{% endif %}>Выберите роль</option>
                        <option value="admin" {% if request.role|default('') == 'admin' %}selected{% endif %}>Администратор</option>
                        <option value="manager" {% if request.role|default('') == 'manager' %}selected{% endif %}>Менеджер</option>
                    </select>
                    {% if errors.role is defined and errors.role %}
                        <span class="field__error" role="alert">{{ errors.role }}</span>
                    {% endif %}
                </div>

                <div class="user-form__actions">
                    {{ include('components/button.html.twig', {
                        variant: 'primary',
                        text: 'Создать',
                    }) }}
                    {{ include('components/button.html.twig', {
                        variant: 'secondary',
                        text: 'Отмена',
                        href: path('app_user_list'),
                        type: 'button',
                    }) }}
                </div>
            </form>
        </div>
    </section>
{% endblock %}
