{#
    Список пользователей для администратора (change add-new-user).
    Таблица с email, именем, фамилией, ролью и кнопкой удаления.
    Кнопка удаления отсутствует для текущего аутентифицированного администратора.
    Ожидает: users (User[]).
#}
{% extends 'base.html.twig' %}

{% block title %}Пользователи{% endblock %}

{% block body %}
    <section class="section section--white">
        <div class="container">
            <h1>Пользователи</h1>

            <div class="user-list__actions">
                {{ include('components/button.html.twig', {
                    variant: 'primary',
                    text: 'Новый пользователь',
                    href: path('app_user_new'),
                    sm: true,
                }) }}
            </div>

            {% if users is not empty %}
                <table class="table">
                    <thead>
                        <tr>
                            <th>Логин</th>
                            <th>Email</th>
                            <th>Имя</th>
                            <th>Фамилия</th>
                            <th>Роль</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for user in users %}
                            <tr data-user-row>
                                <td>{{ user.login }}</td>
                                <td>{{ user.email|default('—') }}</td>
                                <td>{{ user.name|default('—') }}</td>
                                <td>{{ user.surname|default('—') }}</td>
                                <td>{{ user.role.value == 'admin' ? 'Администратор' : 'Менеджер' }}</td>
                                <td>
                                    {% if user.id != app.user.id %}
                                        <a href="{{ path('app_user_delete', { id: user.id }) }}" class="btn btn--secondary btn--sm">Удалить</a>
                                    {% endif %}
                                    {% if user.role.value == 'manager' %}
                                        <a href="{{ path('app_user_assign', { id: user.id }) }}" class="btn btn--secondary btn--sm">Назначить группы</a>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% else %}
                <p>Пользователей нет.</p>
            {% endif %}
        </div>
    </section>
{% endblock %}
