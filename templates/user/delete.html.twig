{#
    Подтверждение удаления пользователя (change add-new-user, organization-groups, enhance-org-tables).
    Предупреждает о необратимости действия; показывает группы, созданные
    пользователем, с числом организаций и назначенными менеджерами.
    Для каждой группы необходимо выбрать: переназначить администратору или удалить.
    Показывает организации, созданные пользователем, с примечанием об автоматическом
    переназначении администратору.
    Ожидает: user (User), createdGroups (OrganizationGroup[]), createdOrgs (Organization[]).
#}
{% extends 'base.html.twig' %}

{% block title %}Удаление пользователя{% endblock %}

{% block body %}
    <section class="section section--white">
        <div class="container">
            <h1>Удаление пользователя</h1>

            <p class="user-delete__warning">
                Пользователь «{{ user.email }}» будет удалён. Действие необратимо.
            </p>

            <form method="post" action="{{ path('app_user_remove', { id: user.id }) }}" class="user-delete__form">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('user') }}">

                {% if createdOrgs is not empty %}
                    <div class="user-delete__orgs">
                        <h2>Организации, созданные пользователем</h2>
                        <p>Следующие организации ({{ createdOrgs|length }}) будут переназначены вам:</p>
                        <ul>
                            {% for org in createdOrgs %}
                                <li>{{ org.name }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}

                {% if createdGroups is not empty %}
                    <div class="user-delete__groups">
                        <h2>Группы, созданные пользователем</h2>
                        <p>Для каждой группы выберите действие:</p>

                        {% for group in createdGroups %}
                            <div class="user-delete__group" data-group-row>
                                <h3>{{ group.name }}</h3>
                                {% if group.description %}
                                    <p>{{ group.description }}</p>
                                {% endif %}
                                <ul class="user-delete__group-meta">
                                    <li>Организаций в группе: {{ group.memberships|length }}</li>
                                    <li>
                                        Назначена менеджерам:
                                        {% for assignment in group.assignments %}
                                            {{ (assignment.user.name|default('') ~ ' ' ~ assignment.user.surname|default(''))|trim
                                                ?: assignment.user.email }}{{ not loop.last ? ', ' }}
                                        {% else %}
                                            никому
                                        {% endfor %}
                                    </li>
                                </ul>
                                <div class="user-delete__group-actions">
                                    <label class="user-delete__choice">
                                        <input type="radio" name="group_action_{{ group.id }}" value="reassign" required>
                                        Переназначить администратору
                                    </label>
                                    <label class="user-delete__choice">
                                        <input type="radio" name="group_action_{{ group.id }}" value="delete" required>
                                        Удалить группу
                                    </label>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}

                <div class="user-delete__actions">
                    {{ include('components/button.html.twig', { variant: 'secondary', text: 'Удалить' }) }}
                    {{ include('components/button.html.twig', {
                        variant: 'secondary',
                        text: 'Отмена',
                        href: path('app_user_list'),
                        type: 'button',
                    }) }}
                </div>
            </form>
        </div>
    </section>
{% endblock %}
