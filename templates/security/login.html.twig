{% extends 'base.html.twig' %}

{% block title %}Вход{% endblock %}

{% block body %}
    <section class="section section--white">
        <div class="container">
            {% if error %}
                <div class="alert alert--error" role="alert">Неверный логин или пароль</div>
            {% endif %}

            <h1>Вход</h1>

            {# --- Форма входа --- #}
            <form id="login-form" method="post" action="{{ path('app_login') }}">
                {{ include('components/form_field.html.twig', { name: '_login', label: 'Логин', type: 'text', value: last_login|default(''), required: true, autofocus: true }, with_context = false) }}
                {{ include('components/form_field.html.twig', { name: '_password', label: 'Пароль', type: 'password', required: true }, with_context = false) }}
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <label class="field__consent">
                    <input type="checkbox" id="new-user-toggle">
                    Новый пользователь
                </label>
                <label class="field__consent">
                    <input type="checkbox" name="_remember_me">
                    Запомнить меня
                </label>
                {% include 'components/button.html.twig' with { variant: 'primary', text: 'Войти' } %}
            </form>

            {# --- Форма установки пароля --- #}
            <form id="setup-password-form" method="post" action="{{ path('app_setup_password') }}" style="display:none">
                {{ include('components/form_field.html.twig', { name: 'login', label: 'Логин', type: 'text', value: setup_login|default(''), required: true }, with_context = false) }}
                {{ include('components/form_field.html.twig', { name: 'new_password', label: 'Новый пароль', type: 'password', required: true }, with_context = false) }}
                {{ include('components/form_field.html.twig', { name: 'confirm_password', label: 'Повторите пароль', type: 'password', required: true }, with_context = false) }}
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('setup-password') }}">
                <label class="field__consent">
                    <input type="checkbox" id="new-user-toggle-back">
                    Новый пользователь
                </label>
                {% include 'components/button.html.twig' with { variant: 'primary', text: 'Установить пароль' } %}
            </form>
        </div>
    </section>

    <script>
        (function() {
            var toggle = document.getElementById('new-user-toggle');
            var toggleBack = document.getElementById('new-user-toggle-back');
            var loginForm = document.getElementById('login-form');
            var setupForm = document.getElementById('setup-password-form');
            var loginLogin = loginForm.querySelector('input[name="_login"]');
            var setupLogin = setupForm.querySelector('input[name="login"]');

            function syncLogin(from, to) {
                if (from.value) { to.value = from.value; }
            }

            function showLogin() {
                syncLogin(setupLogin, loginLogin);
                loginForm.style.display = '';
                setupForm.style.display = 'none';
                toggle.checked = false;
                toggleBack.checked = false;
            }

            function showSetup() {
                syncLogin(loginLogin, setupLogin);
                loginForm.style.display = 'none';
                setupForm.style.display = '';
                toggle.checked = true;
                toggleBack.checked = true;
            }

            toggle.addEventListener('change', function() {
                if (this.checked) { showSetup(); } else { showLogin(); }
            });

            toggleBack.addEventListener('change', function() {
                if (this.checked) { showSetup(); } else { showLogin(); }
            });

            {% if setup_login|default('') is not empty %}
            loginForm.style.display = 'none';
            setupForm.style.display = '';
            toggle.checked = true;
            toggleBack.checked = true;
            {% endif %}
        })();
    </script>
{% endblock %}
