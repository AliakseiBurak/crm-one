{#
    Форма организации: создание (organization is null) и редактирование
    (change organizations-crud). Поля — компонент form_field (подчёркивание
    дизайн-системы), ошибки валидации — под полем на русском.
    Ожидает: organization (?Organization), errors (array<string, string>),
    errorRecipients (CampaignRecipient[]|null), groups (OrganizationGroup[]),
    groupIds (int[]), hides (OrganizationHide[]).
#}
{% extends 'base.html.twig' %}

{% set isEdit = organization and organization.id %}

{% block title %}{{ isEdit ? 'Редактирование организации' : 'Новая организация' }}{% endblock %}

{% block body %}
    <section class="section section--white">
        <div class="container">
            <h1>{{ isEdit ? 'Редактирование организации' : 'Новая организация' }}</h1>

            <form
                class="organization-form"
                method="post"
                action="{{ isEdit
                    ? path('app_organization_update', { id: organization.id })
                    : path('app_organization_create') }}"
            >
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('organization') }}">

                {% if isEdit %}
                    <div class="organization-form__meta">
                        {% if organization.createdBy %}
                            <span class="organization-form__meta-item">
                                Создатель:
                                {{ (organization.createdBy.name|default('') ~ ' ' ~ organization.createdBy.surname|default(''))|trim
                                    ?: organization.createdBy.email }}
                            </span>
                        {% endif %}
                        {% if organization.createdAt %}
                            <span class="organization-form__meta-item">
                                Дата создания: {{ organization.createdAt|date('d.m.Y H:i') }}
                            </span>
                        {% endif %}
                    </div>
                {% endif %}

                {{ include('components/form_field.html.twig', {
                    name: 'name',
                    label: 'Название',
                    value: organization.name|default(''),
                    error: errors.name|default(null),
                }) }}

                {{ include('components/form_field.html.twig', {
                    name: 'industry',
                    label: 'Сфера деятельности',
                    value: organization.industry|default(''),
                    error: errors.industry|default(null),
                }) }}

                {{ include('components/form_field.html.twig', {
                    name: 'unp',
                    label: 'УНП',
                    value: organization.unp|default(''),
                    error: errors.unp|default(null),
                }) }}

                {{ include('components/form_field.html.twig', {
                    name: 'annualPlan',
                    label: 'Годовой план',
                    value: organization.annualPlan|default(''),
                    error: errors.annualPlan|default(null),
                }) }}

                {{ include('components/form_field.html.twig', {
                    type: 'textarea',
                    name: 'description',
                    label: 'Описание',
                    value: organization.description|default(''),
                    error: errors.description|default(null),
                }) }}

                <div class="field">
                    <label class="field__label">
                        <input type="hidden" name="isActive" value="0">
                        <input type="checkbox" name="isActive" value="1" {% if not organization or organization.isActive %}checked{% endif %}>
                        Активна
                    </label>
                </div>

                <div class="field">
                    <label class="field__label">
                        <input type="hidden" name="isOptedOut" value="0">
                        <input type="checkbox" name="isOptedOut" value="1" {% if organization.isOptedOut|default(false) %}checked{% endif %}>
                        Отказ от рассылки
                    </label>
                </div>

                <div class="field js-opt-out-reason" {% if not organization.isOptedOut|default(false) %}hidden{% endif %}>
                    <label class="field__label" for="organization-optOutReason">Причина отказа</label>
                    <textarea class="field__input" id="organization-optOutReason" name="optOutReason" rows="3">{{ organization.optOutReason|default('') }}</textarea>
                </div>

                {{ include('components/form_field.html.twig', {
                    name: 'coursesAttended',
                    label: 'Учились у нас',
                    value: organization.coursesAttended|default(''),
                    error: errors.coursesAttended|default(null),
                }) }}

                {% if groups is defined and groups is not empty %}
                    <div class="field">
                        <label class="field__label organization-section-title">Группы</label>
                        <div class="group-chips">
                            {% for group in groups %}
                                <label
                                    class="group-chip"
                                    style="--chip-color: {{ group.color|default('#5a5a5a') }}"
                                    {% if group.description %}title="{{ group.description }}"{% endif %}
                                >
                                    <input
                                        type="checkbox"
                                        name="groups[]"
                                        value="{{ group.id }}"
                                        {% if group.id in groupIds %}checked{% endif %}
                                    >
                                    <span>{{ group.name }}</span>
                                </label>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}

                {% if isEdit %}
                    <div class="organization-form__contacts">
                        <h2 class="organization-section-title">Контакты</h2>
                        {% set contacts = contacts|default(organization.contacts) %}
                        {% if contacts is not empty %}
                            <ul class="organization-contacts__list">
                                {% for contact in contacts %}
                                    <li>
                                        <a href="{{ path('app_contact_edit', { id: contact.id }) }}"
                                           {% if contact.id == effectiveMainId|default(null) %}class="organization-contacts__name organization-contacts__name--main"{% endif %}>{{ contact.name }}</a>
                                        {% if contact.isMain %}<span class="organization-contacts__badge">Основной</span>{% endif %}
                                        {% if contact.email %} — {{ contact.email }}{% endif %}
                                    </li>
                                {% endfor %}
                            </ul>
                        {% else %}
                            <p class="organization-contacts__empty">Контактов нет.</p>
                        {% endif %}
                    </div>

                    {% if errorRecipients is defined and errorRecipients|length > 0 %}
                        <div class="organization-form__errors">
                            <h2>Ошибки доставки рассылок</h2>
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>Рассылка</th>
                                        <th>Контакт</th>
                                        <th>Статус</th>
                                        <th>Ошибка</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for recipient in errorRecipients %}
                                        <tr>
                                            <td>{{ recipient.campaign.name }}</td>
                                            <td>
                                                {% if recipient.contact %}
                                                    <a href="{{ path('app_contact_edit', { id: recipient.contact.id }) }}">{{ recipient.contact.name }}</a>
                                                {% else %}
                                                    —
                                                {% endif %}
                                            </td>
                                            <td>
                                                {% if recipient.status.value == 'failed' %}
                                                    <span class="campaign-recipients__status campaign-recipients__status--failed">Ошибка</span>
                                                {% elseif recipient.status.value == 'bounced' %}
                                                    <span class="campaign-recipients__status campaign-recipients__status--bounced">Отказ</span>
                                                {% endif %}
                                                {% if recipient.status.value == 'failed' %}
                                                    <button type="button" class="campaign-recipients__reset-btn" title="Сбросить"
                                                        data-action="reset-recipient"
                                                        data-url="{{ path('app_campaign_recipient_reset', { id: recipient.campaign.id, recipientId: recipient.id }) }}"
                                                        data-csrf="{{ csrf_token('campaign_recipient') }}">✕</button>
                                                {% elseif recipient.status.value == 'bounced' %}
                                                    <a href="{{ path('app_campaign_recipient_reset_confirm', { id: recipient.campaign.id, recipientId: recipient.id }) }}" class="campaign-recipients__reset-btn" title="Сбросить">✕</a>
                                                {% endif %}
                                            </td>
                                            <td>{{ recipient.errorMessage|default('') }}</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}

                    {% if is_granted('ROLE_ADMIN') %}
                        <div class="organization-form__hides">
                            <h2 class="organization-section-title">Скрыто от менеджеров</h2>
                            {% if hides is not empty %}
                                <ul class="organization-hides__list">
                                    {% for hide in hides %}
                                        <li class="organization-hides__item">
                                            <span class="organization-hides__name">
                                                {% set managerName = (hide.manager.name|default('') ~ ' ' ~ hide.manager.surname|default(''))|trim %}
                                                {{ managerName ?: hide.manager.email }}
                                            </span>
                                            <button type="submit" name="unhide" value="{{ hide.id }}" class="btn btn--secondary btn--sm">Показать</button>
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% else %}
                                <p class="organization-hides__empty">Не скрыта ни от одного менеджера.</p>
                            {% endif %}
                        </div>
                    {% endif %}
                {% endif %}

                <div class="organization-form__actions">
                    {{ include('components/button.html.twig', {
                        variant: 'primary',
                        text: isEdit ? 'Сохранить' : 'Создать',
                    }) }}
                    {{ include('components/button.html.twig', {
                        variant: 'secondary',
                        text: 'Отмена',
                        href: path('app_dashboard'),
                        type: 'button',
                    }) }}
                    {% if isEdit %}
                        {{ include('components/button.html.twig', {
                            variant: 'secondary',
                            text: 'Удалить',
                            href: path('app_organization_delete', { id: organization.id }),
                            type: 'button',
                            attr: { class: 'organization-form__delete' },
                        }) }}
                    {% endif %}
                </div>
            </form>
        </div>
    </section>

    <script>
        document.addEventListener('click', (e) => {
            const btn = e.target.closest('[data-action="reset-recipient"]');
            if (!btn) return;
            if (!confirm('Сбросить статус получателя?')) return;
            fetch(btn.dataset.url, {
                method: 'POST',
                headers: { 'X-CSRF-Token': btn.dataset.csrf, 'X-Requested-With': 'XMLHttpRequest' }
            }).then(() => btn.closest('tr')?.remove());
        });

        document.addEventListener('DOMContentLoaded', () => {
            const checkbox = document.querySelector('input[name="isOptedOut"]');
            const reasonContainer = document.querySelector('.js-opt-out-reason');
            if (checkbox && reasonContainer) {
                checkbox.addEventListener('change', () => {
                    if (!checkbox.checked) {
                        if (!confirm('Восстановить организацию в рассылках?')) {
                            checkbox.checked = true;
                            return;
                        }
                        const reasonField = document.getElementById('organization-optOutReason');
                        if (reasonField) {
                            reasonField.value = '';
                        }
                    }
                    reasonContainer.hidden = !checkbox.checked;
                });
            }
        });
    </script>
{% endblock %}
