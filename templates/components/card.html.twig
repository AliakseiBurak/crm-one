{#
    Контактная карточка (spec: без кнопки «Позвонить» — звонок по клику
    на номер tel:, почта по клику на email mailto:).
    Параметры: name, phone, position, email, note
#}
{% set card_phone = phone|default('')|replace({' ': '', '(': '', ')': '', '-': ''}) %}
<article class="card">
    {% block card_badge %}{% endblock %}
    <h3 class="card__name">{{ name }}</h3>
    {% if card_phone %}
        <a class="card__phone" href="tel:{{ card_phone }}">{{ phone }}</a>
    {% endif %}
    {% if position is defined and position %}<p class="card__meta">Должность: {{ position }}</p>{% endif %}
    {% if email is defined and email %}<p class="card__meta">Email: <a href="mailto:{{ email }}">{{ email }}</a></p>{% endif %}
    {% if note is defined and note %}<p class="card__meta">Заметка: {{ note }}</p>{% endif %}
    {% block card_footer %}{% endblock %}
</article>