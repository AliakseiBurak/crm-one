{#
    Шапка (spec): белый фон, логотип слева (→ главная), пункты меню
    в верхней строке; справа для вошедших — «Создать ▾», «⚙ Админ ▾»
    (только админ) и выпадающий список пользователя с «Выйти».
    На экранах ≤768px навигация сворачивается в гамбургер с боковой панелью.
    Параметры: menu — массив {label, href, active}; user — текущий пользователь.
#}
<header class="header">
    <div class="header__top">
        <div class="header__top-inner">
            {% if user %}
                <button class="header__hamburger" type="button" data-header-hamburger aria-label="Меню" aria-expanded="false">☰</button>
            {% endif %}
            <a class="header__logo" href="{{ path('app_home') }}">B2B Call CRM</a>
            {% if menu %}
                <nav class="header__nav" aria-label="Основное меню">
                    {% for item in menu %}
                        <a class="header__menu-link" href="{{ item.href }}"{% if item.active is defined and item.active %} aria-current="page"{% endif %}>{{ item.label }}</a>
                    {% endfor %}
                </nav>
            {% endif %}
            {% if user %}
                <div class="header__actions">
                    <div class="header-create" data-header-create>
                        <button class="header-create__toggle" type="button" data-header-create-toggle aria-haspopup="true" aria-expanded="false">
                            Создать<span class="header-create__caret" aria-hidden="true"></span>
                        </button>
                        <div class="header-create__menu" data-header-create-menu hidden>
                            <a class="header-create__item" href="{{ path('app_organization_new') }}">Организацию</a>
                            <a class="header-create__item" href="{{ path('app_contact_new') }}">Контакт</a>
                            <a class="header-create__item" href="{{ path('app_call_new') }}">Звонок</a>
                            <a class="header-create__item" href="{{ path('app_campaign_new') }}">Рассылку</a>
                            {% if is_granted('ROLE_MANAGER') %}
                                <a class="header-create__item" href="{{ path('app_group_new') }}">Группу</a>
                            {% endif %}
                            {% if is_granted('ROLE_ADMIN') %}
                                <a class="header-create__item" href="{{ path('app_user_new') }}">Пользователя</a>
                            {% endif %}
                        </div>
                    </div>
                    {% if is_granted('ROLE_ADMIN') %}
                        <div class="header-admin" data-header-admin>
                            <button class="header-admin__toggle" type="button" data-header-admin-toggle aria-haspopup="true" aria-expanded="false">
                                ⚙ Админ<span class="header-admin__caret" aria-hidden="true"></span>
                            </button>
                            <div class="header-admin__menu" data-header-admin-menu hidden>
                                <a class="header-admin__item" href="{{ path('app_user_list') }}">Пользователи</a>
                                <a class="header-admin__item" href="{{ path('app_organization_hide_list') }}">Скрытые организации</a>
                            </div>
                        </div>
                    {% endif %}
                    <div class="header-user" data-header-user>
                        <button class="header-user__toggle" type="button" data-header-user-toggle aria-haspopup="true" aria-expanded="false">
                            Профиль<span class="header-user__caret" aria-hidden="true"></span>
                        </button>
                        <div class="header-user__menu" data-header-user-menu hidden>
                            <div class="header-user__info">
                                <span class="header-user__info-username">{{ user.login }}</span>
                                {% if user.name or user.surname %}
                                    <span class="header-user__info-name">{{ [user.name, user.surname]|filter(v => v)|join(' ') }}</span>
                                {% endif %}
                                {% if user.email %}
                                    <span class="header-user__info-email">{{ user.email }}</span>
                                {% endif %}
                            </div>
                            <a class="header-user__item" href="{{ path('app_logout') }}">Выйти</a>
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
    {% if user %}
        <div class="header__sidebar" data-header-sidebar>
            <nav class="header__sidebar-nav" aria-label="Мобильное меню">
                {% for item in menu %}
                    <a class="header__sidebar-link" href="{{ item.href }}">{{ item.label }}</a>
                {% endfor %}
            </nav>
            <div class="header-create header-create--sidebar" data-header-create>
                <button class="header-create__toggle" type="button" data-header-create-toggle aria-haspopup="true" aria-expanded="false">
                    Создать<span class="header-create__caret" aria-hidden="true"></span>
                </button>
                <div class="header-create__menu" data-header-create-menu hidden>
                    <a class="header-create__item" href="{{ path('app_organization_new') }}">Организацию</a>
                    <a class="header-create__item" href="{{ path('app_contact_new') }}">Контакт</a>
                    <a class="header-create__item" href="{{ path('app_call_new') }}">Звонок</a>
                    <a class="header-create__item" href="{{ path('app_campaign_new') }}">Рассылку</a>
                    {% if is_granted('ROLE_MANAGER') %}
                        <a class="header-create__item" href="{{ path('app_group_new') }}">Группу</a>
                    {% endif %}
                    {% if is_granted('ROLE_ADMIN') %}
                        <a class="header-create__item" href="{{ path('app_user_new') }}">Пользователя</a>
                    {% endif %}
                </div>
            </div>
            <div class="header__sidebar-user">
                <span class="header__sidebar-user-name">{{ user.login }}</span>
                {% if user.name or user.surname %}
                    <span class="header__sidebar-user-fullname">{{ [user.name, user.surname]|filter(v => v)|join(' ') }}</span>
                {% endif %}
                {% if user.email %}
                    <span class="header__sidebar-user-email">{{ user.email }}</span>
                {% endif %}
                <a class="header__sidebar-logout" href="{{ path('app_logout') }}">Выйти</a>
            </div>
        </div>
        <div class="header__sidebar-overlay" data-header-sidebar-overlay></div>
    {% endif %}
</header>
