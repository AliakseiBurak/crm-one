{#
    Строка звонка в списке «Все звонки» организации на панели.
#}
<li class="org-calls__item"
    data-call-row
    data-call-id="{{ call.id }}"
    data-call-org-id="{{ call.organizationId }}"
    data-call-contact-id="{{ call.contactId }}"
    data-call-scheduled-at="{{ call.scheduledAt ? call.scheduledAt|date('d.m.Y H:i') : '' }}"
    data-call-made="{{ call.madeAt ? '1' : '0' }}"
    data-call-made-at="{{ call.madeAt ? call.madeAt|date('d.m.Y H:i') : '' }}"
    data-call-made-by="{{ call.madeById ?? '' }}"
    data-call-is-deal="{{ call.isDeal ? '1' : '0' }}"
    data-call-is-refusal="{{ call.isRefusal ? '1' : '0' }}"
    data-call-is-no-answer="{{ call.isNoAnswer ? '1' : '0' }}"
    data-call-campaign-id="{{ call.campaignId ?? '' }}"
    data-call-campaign-name="{{ call.campaignName ?? '' }}"
    data-call-next-call-id="{{ call.nextCallId ?? '' }}"
    data-call-next-call-date="{{ call.nextCallScheduledAt ? call.nextCallScheduledAt|date('d.m.Y') : '' }}"
    data-call-notes="{{ call.notes }}">
    <span class="org-calls__body">
        <span class="org-calls__status" title="{{ call.madeAt ? 'Проведён' : 'Запланирован' }}" aria-hidden="true">{{ call.madeAt ? '☎️' : '⏰' }}</span><a class="org-calls__date" href="{{ path('app_call_edit', { id: call.id }) }}">{{ call.date ? call.date|date('d.m.Y') : '—' }}</a>{% if call.notes %} — {{ call.notes }}{% endif %}
        {% if call.isDeal %}<span class="org-calls__deal">— сделка</span>{% endif %}
        {% if call.isNoAnswer %}<span class="org-calls__no-answer">— нет ответа</span>{% endif %}
        {% if call.campaignName %}<span class="org-calls__mailing">— рассылка: {{ call.campaignName }}</span>{% endif %}
        {% if callContact %}
            <span class="org-calls__item-contact">
                контакт: <em>{{ callContact.name }}</em>
                {% if callContact.phone %}<a href="tel:{{ callContact.phone|default('')|replace({' ': '', '(': '', ')': '', '-': ''}) }}">{{ callContact.phone }}</a>{% endif %}
                {% if callContact.email %}<a href="mailto:{{ callContact.email }}">{{ callContact.email }}</a>{% endif %}
            </span>
        {% endif %}
    </span>
    <button class="btn btn--secondary btn--sm org-calls__edit" type="button" data-call-edit>Изменить</button>
</li>
