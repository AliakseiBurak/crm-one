{#
    Карточка рассылки (change campaign-entity): тема, превью, текст письма,
    вложения, статус, кнопка «Запустить» (для не запущенных), индикация
    запущенности (launched_at), счётчик прогресса.
    Ожидает: campaign (Campaign).
#}
{% extends 'base.html.twig' %}

{% block title %}Рассылка «{{ campaign.name }}»{% endblock %}

{% block body %}
    <section class="section section--white">
        <div class="container">
            <h1>Рассылка «{{ campaign.name }}»</h1>

            <article class="campaign-card">
                <dl class="campaign-card__fields campaign-card__fields--top">
                    <div class="campaign-card__row">
                        <dt>Статус</dt>
                        <dd>
                            <span id="campaign-status">{{ campaign.status.label() }}</span>
                            {% if campaign.status.value == 'launched' or campaign.status.value == 'failed' %}
                                <span id="campaign-progress" class="campaign-progress">
                                    {% set total = campaign.recipients|length %}
                                    {% set processed = 0 %}
                                    {% for r in campaign.recipients %}
                                        {% if r.status.value in ['delivered','bounced','failed','opened'] %}
                                            {% set processed = processed + 1 %}
                                        {% endif %}
                                    {% endfor %}
                                    — обработано {{ processed }} из {{ total }}
                                </span>
                            {% endif %}
                        </dd>
                    </div>
                    {% if campaign.failureReason %}
                        <div class="campaign-card__row">
                            <dt>Причина ошибки</dt>
                            <dd><span class="campaign-status campaign-status--failed" id="campaign-failure-reason">{{ campaign.failureReason }}</span></dd>
                        </div>
                    {% else %}
                        <div class="campaign-card__row" id="campaign-failure-row" style="display:none">
                            <dt>Причина ошибки</dt>
                            <dd><span class="campaign-status campaign-status--failed" id="campaign-failure-reason"></span></dd>
                        </div>
                    {% endif %}
                    <div class="campaign-card__row">
                        <dt>Запуск</dt>
                        <dd>
                            {% if campaign.launchedAt %}
                                <span class="campaign-status campaign-status--launched">Первый запуск {{ campaign.launchedAt|date('d.m.Y H:i') }}</span>
                            {% else %}
                                Не запущена
                            {% endif %}
                        </dd>
                    </div>
                    {% if campaign.failedAt %}
                        <div class="campaign-card__row">
                            <dt>Ошибка</dt>
                            <dd><span class="campaign-status campaign-status--failed">Ошибка {{ campaign.failedAt|date('d.m.Y H:i') }}</span></dd>
                        </div>
                    {% endif %}
                </dl>

                <dl class="campaign-card__fields">
                    <div class="campaign-card__row">
                        <dt>Тема письма</dt>
                        <dd>{{ campaign.subject }}</dd>
                    </div>
                    {% if campaign.previewText %}
                        <div class="campaign-card__row">
                            <dt>Превью</dt>
                            <dd>{{ campaign.previewText }}</dd>
                        </div>
                    {% endif %}
                    <div class="campaign-card__row">
                        <dt>Текст письма</dt>
                        <dd><div class="campaign-card__body-html">{{ campaign.body|raw }}</div></dd>
                    </div>
                    <div class="campaign-card__row">
                        <dt>Вложения</dt>
                        <dd>
                            {% if campaign.attachments is empty %}
                                нет
                            {% else %}
                                <ul class="campaign-attachments__list">
                                    {% for attachment in campaign.attachments %}
                                        <li class="campaign-attachments__item">
                                            <span class="campaign-attachments__name">{{ attachment.filename }}</span>
                                            {% if attachment.size %}
                                                <span class="campaign-attachments__size">{{ (attachment.size / 1024)|round(1) }} КБ</span>
                                            {% endif %}
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                        </dd>
                    </div>
                </dl>

                <div class="campaign-card__actions-row">
                    {{ include('components/button.html.twig', {
                        variant: 'secondary',
                        text: 'Адресаты',
                        href: path('app_campaign_recipients', { id: campaign.id }),
                        type: 'button',
                    }) }}
                    {{ include('components/button.html.twig', {
                        variant: 'secondary',
                        text: 'Назад к списку',
                        href: path('app_campaign_index'),
                        type: 'button',
                    }) }}
                </div>

                {% if campaign.status.value != 'draft' %}
                    <div class="campaign-card__clone-row">
                        <form method="post" action="{{ path('app_campaign_clone', { id: campaign.id }) }}" class="campaign-clone-form">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('campaign') }}">
                            {{ include('components/button.html.twig', {
                                variant: 'secondary',
                                text: 'Клонировать',
                            }) }}
                            <label class="campaign-clone-form__option">
                                <input type="radio" name="clone_mode" value="none" checked>
                                Без адресатов
                            </label>
                            <label class="campaign-clone-form__option">
                                <input type="radio" name="clone_mode" value="recipients">
                                С адресатами
                            </label>
                            <label class="campaign-clone-form__option">
                                <input type="radio" name="clone_mode" value="recipients_with_contacts">
                                С адресатами и контактами
                            </label>
                        </form>
                    </div>
                {% endif %}

                <div class="campaign-card__actions">
                    {% if campaign.status.value == 'ready' %}
                        <form method="post" action="{{ path('app_campaign_launch', { id: campaign.id }) }}">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('campaign') }}">
                            {{ include('components/button.html.twig', {
                                variant: 'primary',
                                text: 'Запустить',
                            }) }}
                        </form>
                    {% endif %}
                    {% if campaign.status.value == 'failed' %}
                        <form method="post" action="{{ path('app_campaign_reset', { id: campaign.id }) }}">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('campaign') }}">
                            {{ include('components/button.html.twig', {
                                variant: 'secondary',
                                text: 'Сбросить',
                            }) }}
                        </form>
                    {% endif %}
                    {% if campaign.status.value == 'launched' %}
                        <form method="post" action="{{ path('app_campaign_stop', { id: campaign.id }) }}">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('campaign') }}">
                            {{ include('components/button.html.twig', {
                                variant: 'secondary',
                                text: 'Остановить',
                            }) }}
                        </form>
                    {% endif %}
                    {{ include('components/button.html.twig', {
                        variant: 'secondary',
                        text: 'Предпросмотр',
                        type: 'button',
                        attr: { 'data-campaign-preview-open': '' },
                    }) }}
                    {{ include('components/button.html.twig', {
                        variant: 'secondary',
                        text: 'Редактировать',
                        href: path('app_campaign_edit', { id: campaign.id }),
                        type: 'button',
                    }) }}
                </div>
            </article>
        </div>
    </section>

    {{ include('campaign/_preview_modal.html.twig', {
        previewUrl: path('app_campaign_preview', { id: campaign.id }),
    }) }}

    <script>
        (function() {
            var campaignId = {{ campaign.id }};
            var statusLabels = {{ statusLabels|json_encode|raw }};
            var statsCache = {};
            var currentStatus = {{ campaign.status.value|json_encode|raw }};
            var progressEl = document.getElementById('campaign-progress');
            var statusEl = document.getElementById('campaign-status');
            function updateVisibility(status) {
                if (!progressEl) return;
                if (status === 'launched' || status === 'failed') {
                    progressEl.style.display = '';
                } else {
                    progressEl.style.display = 'none';
                }
            }
            setInterval(function() {
                fetch('/campaigns/statuses')
                    .then(function(r) { return r.json(); })
                    .then(function(data) {
                        var found = null;
                        for (var i = 0; i < data.length; i++) {
                            if (data[i].campaignId === campaignId) { found = data[i]; break; }
                        }
                        if (!found) return;
                        if (found.status !== currentStatus) {
                            currentStatus = found.status;
                            if (statusEl) statusEl.textContent = found.label;
                            updateVisibility(found.status);
                        }
                        var prev = statsCache[campaignId];
                        if (prev && prev.delivered === found.delivered && prev.total === found.total) return;
                        statsCache[campaignId] = found;
                        if (progressEl) {
                            progressEl.textContent = 'обработано ' + found.delivered + ' из ' + found.total;
                        }
                    });
            }, 1900);
        })();
    </script>
{% endblock %}
