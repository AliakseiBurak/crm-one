{#
    Страница адресатов рассылки: список, добавление, удаление.
    Редактирование доступно для всех статусов, кроме archived.
    Ожидает: campaign (Campaign), availableOrganizations (Organization[]),
    availableGroups (OrganizationGroup[]).
#}
{% extends 'base.html.twig' %}

{% block title %}Адресаты — {{ campaign.name }}{% endblock %}

{% block body %}
    <section class="section section--white">
        <div class="container">
            <h1>Адресаты рассылки «{{ campaign.name }}»</h1>

            {% set canEdit = campaign.status.value != 'archived' %}

            {% set hasGroups = canEdit and availableGroups is not empty %}
            {% if (canEdit and availableOrganizations is not empty) or hasGroups %}
                <div class="campaign-recipients__bulk-row">
                    {% if canEdit and availableOrganizations is not empty %}
                        <form method="post" action="{{ path('app_campaign_recipient_bulk', { id: campaign.id }) }}">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('campaign_recipient') }}">
                            {{ include('components/button.html.twig', {
                                variant: 'secondary',
                                text: 'Выбрать все организации',
                                sm: true,
                            }) }}
                        </form>
                    {% endif %}

                    {% if hasGroups %}
                        {% for group in availableGroups %}
                            <form method="post" action="{{ path('app_campaign_recipients_bulk_by_group', { id: campaign.id }) }}">
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('campaign') }}">
                                <input type="hidden" name="group_id" value="{{ group.id }}">
                                {{ include('components/button.html.twig', {
                                    variant: 'secondary',
                                    text: group.name,
                                    sm: true,
                                    attr: { 'data-group-id': group.id }
                                        |merge(group.color ? { style: 'background:' ~ group.color ~ ';color:#fff;border-color:' ~ group.color } : {})
                                        |merge(group.description ? { title: group.description } : {}),
                                }) }}
                            </form>
                        {% endfor %}
                    {% endif %}
                </div>
            {% endif %}

            {% if canEdit %}
                <div class="campaign-recipients__add">
                    <form method="post" action="{{ path('app_campaign_recipient_add', { id: campaign.id }) }}" class="campaign-recipients__add-form">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('campaign_recipient') }}">
                        <div class="field">
                            <select class="field__input" name="organization" id="recipient-organization" required data-org-combobox>
                                <option value="">Выберите организацию…</option>
                                {% for org in availableOrganizations %}
                                    <option value="{{ org.id }}">{{ org.name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <select class="field__input" name="contact" id="recipient-contact">
                            <option value="">— вся организация —</option>
                        </select>
                        {{ include('components/button.html.twig', {
                            variant: 'primary',
                            text: 'Добавить',
                            sm: true,
                        }) }}
                    </form>
                </div>

                <script>
                    (() => {
                        const contactsByOrg = {{ contactsByOrg|json_encode|raw }};
                        const orgSelect = document.getElementById('recipient-organization');
                        const contactSelect = document.getElementById('recipient-contact');

                        orgSelect.addEventListener('change', () => {
                            const orgId = orgSelect.value;
                            const contacts = contactsByOrg[orgId] || [];
                            contactSelect.innerHTML = '<option value="">— вся организация —</option>';
                            contacts.forEach(c => {
                                const opt = document.createElement('option');
                                opt.value = c.id;
                                opt.textContent = c.name + (c.email ? ' (' + c.email + ')' : '');
                                contactSelect.appendChild(opt);
                            });
                        });
                    })();
                </script>
            {% endif %}

            {% if recipients is not empty %}
                <div class="table-wrap">
                    <table class="table campaign-recipients__table">
                        <thead>
                            <tr>
                                <th scope="col">Организация</th>
                                <th scope="col">Контакт</th>
                                <th scope="col">Статус</th>
                                <th scope="col">Повторно*</th>
                                <th scope="col"></th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for recipient in recipients %}
                                <tr data-recipient-id="{{ recipient.id }}">
                                    <td>
                                        <a href="{{ path('app_organization_edit', { id: recipient.organization.id }) }}">{{ recipient.organization.name }}</a>
                                        {% if recipient.errorMessage %}
                                            <br><span class="campaign-recipients__error-message">{{ recipient.errorMessage }}</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if recipient.contact %}
                                            <a href="{{ path('app_contact_edit', { id: recipient.contact.id }) }}">{{ recipient.contact.name }}</a>{% if recipient.contact.email %} ({{ recipient.contact.email }}){% endif %}
                                        {% else %}
                                            —
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% set statusValue = recipient.status.value %}
                                        {% set statusClass = 'campaign-recipients__status--' ~ statusValue %}
                                        <span class="campaign-recipients__status {{ statusClass }}">{{ recipient.status.label() }}</span>
                                        {% if canEdit and statusValue == 'failed' %}
                                            <form method="post" action="{{ path('app_campaign_recipient_reset', { id: campaign.id, recipientId: recipient.id }) }}" style="display:inline" onsubmit="return confirm('Сбросить статус получателя?')">
                                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('campaign_recipient') }}">
                                                <button type="submit" class="campaign-recipients__reset-btn" title="Сбросить">✕</button>
                                            </form>
                                        {% elseif canEdit and statusValue == 'bounced' %}
                                            <a href="{{ path('app_campaign_recipient_reset_confirm', { id: campaign.id, recipientId: recipient.id }) }}" class="campaign-recipients__reset-btn" title="Сбросить">✕</a>
                                        {% endif %}
                                    </td>
                                    <td>{{ recipient.replacementCount }}</td>
            {% if canEdit %}
                                        <td class="campaign-recipients__actions">
                                            <form method="post" action="{{ path('app_campaign_recipient_remove', { id: campaign.id, recipientId: recipient.id }) }}" style="display:inline"
                                                  onsubmit="return confirm('Убрать адресата?')">
                                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('campaign_recipient') }}">
                                                <button type="submit" class="btn btn--secondary btn--sm">Убрать</button>
                                            </form>
                                        </td>
                                    {% endif %}
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                    <p class="campaign-recipients__footnote">* В случае повторного добавления организации/контакта в статусе отличном от "Ожидает", эл. письмо будет отправлено повторно.</p>
                </div>
            {% else %}
                <p class="campaign-recipients__empty">Адресатов пока нет.</p>
            {% endif %}

            <div class="campaign-recipients__back">
                {{ include('components/button.html.twig', {
                    variant: 'secondary',
                    text: '← Назад к рассылке',
                    href: path('app_campaign_show', { id: campaign.id }),
                    type: 'button',
                }) }}
            </div>
        </div>
    </section>

    <script>
        (function() {
            var campaignId = {{ campaign.id }};
            var statusCache = {};
            var currentClasses = {};
            setInterval(function() {
                fetch('/campaigns/' + campaignId + '/recipients/statuses')
                    .then(function(r) { return r.json(); })
                    .then(function(data) {
                        data.forEach(function(item) {
                            var prev = statusCache[item.recipientId];
                            if (prev === item.status) return;
                            statusCache[item.recipientId] = item.status;
                            var row = document.querySelector('tr[data-recipient-id="' + item.recipientId + '"]');
                            if (!row) return;
                            var badge = row.querySelector('.campaign-recipients__status');
                            if (!badge) return;
                            badge.textContent = item.label;
                            var oldClass = currentClasses[item.recipientId];
                            if (oldClass) badge.classList.remove(oldClass);
                            var newClass = 'campaign-recipients__status--' + item.status;
                            badge.classList.add(newClass);
                            currentClasses[item.recipientId] = newClass;
                        });
                    });
            }, 1100);
        })();
    </script>
{% endblock %}
