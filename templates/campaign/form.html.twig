{#
    Форма рассылки: создание (campaign is null) и редактирование
    (change campaign-entity). Поля name/subject/body обязательны;
    preview_text — опциональный прехедер; статус — выбор из
     draft/ready/launched/archived (failed — технический, недоступен в форме). Вложения — загрузка файла
    на обеих страницах.
    Ожидает: campaign (?Campaign), errors (array<string, string>),
    attachmentError (?string).
#}
{% extends 'base.html.twig' %}

{% set isEdit = campaign and campaign.id %}

{% block title %}{{ isEdit ? 'Редактирование рассылки' : 'Новая рассылка' }}{% endblock %}

{% block body %}
    <section class="section section--white">
        <div class="container">
            <h1>{{ isEdit ? 'Редактирование рассылки' : 'Новая рассылка' }}</h1>

            <form
                class="campaign-form"
                method="post"
                enctype="multipart/form-data"
                action="{{ isEdit
                    ? path('app_campaign_update', { id: campaign.id })
                    : path('app_campaign_create') }}"
            >
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('campaign') }}">
                <input type="hidden" name="_csrf_preview" value="{{ csrf_token('campaign_preview') }}">

                {{ include('components/form_field.html.twig', {
                    name: 'name',
                    label: 'Название',
                    value: campaign.name|default(''),
                    error: errors.name|default(null),
                }) }}

                <div class="field">
                    <label class="field__label" for="status">Статус</label>
                    <select class="field__input" id="status" name="status">
                        {% for option in enum('App\\Entity\\Enum\\CampaignStatus').cases() %}
                            {% if option.value != 'failed' or (isEdit and campaign.status.value == 'failed') %}
                                {% set selected = campaign and campaign.id ? campaign.status == option : option.value == 'draft' %}
                                <option value="{{ option.value }}"{% if selected %} selected{% endif %}{% if option.value == 'failed' %} class="campaign-status--failed"{% endif %}>{{ option.label() }}</option>
                            {% endif %}
                        {% endfor %}
                    </select>
                    {% if errors.status is defined and errors.status %}
                        <span class="field__error" role="alert">{{ errors.status }}</span>
                    {% endif %}
                </div>

                {{ include('components/form_field.html.twig', {
                    name: 'subject',
                    label: 'Тема письма',
                    value: campaign.subject|default(''),
                    error: errors.subject|default(null),
                }) }}

                {{ include('components/form_field.html.twig', {
                    name: 'preview_text',
                    label: 'Текст превью (прехедер)',
                    value: campaign.previewText|default(''),
                    error: errors.preview_text|default(null),
                    hint: 'Краткое описание для предпросмотра в почте. Можно оставить пустым',
                }) }}

                <div class="field" data-campaign-editor>
                    <label class="field__label" for="body">Текст письма</label>
                    <div class="campaign-editor__toolbar" data-editor-toolbar role="toolbar" aria-label="Форматирование текста">
                        <button type="button" class="campaign-editor__button" data-editor-command="bold" title="Жирный" aria-pressed="false"><strong>Ж</strong></button>
                        <button type="button" class="campaign-editor__button" data-editor-command="italic" title="Курсив" aria-pressed="false"><em>К</em></button>
                        <button type="button" class="campaign-editor__button" data-editor-command="underline" title="Подчёркнутый" aria-pressed="false"><u>Ч</u></button>
                        <button type="button" class="campaign-editor__button" data-editor-command="strike" title="Зачёркнутый" aria-pressed="false"><s>З</s></button>
                        <span class="campaign-editor__separator" aria-hidden="true"></span>
                        <button type="button" class="campaign-editor__button" data-editor-command="heading" data-level="1" title="Заголовок 1" aria-pressed="false">H1</button>
                        <button type="button" class="campaign-editor__button" data-editor-command="heading" data-level="2" title="Заголовок 2" aria-pressed="false">H2</button>
                        <button type="button" class="campaign-editor__button" data-editor-command="heading" data-level="3" title="Заголовок 3" aria-pressed="false">H3</button>
                        <span class="campaign-editor__separator" aria-hidden="true"></span>
                        <button type="button" class="campaign-editor__button" data-editor-command="bulletList" title="Маркированный список" aria-pressed="false">&#8226;</button>
                        <button type="button" class="campaign-editor__button" data-editor-command="orderedList" title="Нумерованный список" aria-pressed="false">1.</button>
                        <span class="campaign-editor__separator" aria-hidden="true"></span>
                        <button type="button" class="campaign-editor__button" data-editor-command="link" title="Ссылка" aria-pressed="false">Ссылка</button>
                        <label class="campaign-editor__color" title="Цвет текста">
                            <input type="color" data-editor-color value="#111827" aria-label="Цвет текста">
                        </label>
                        <button type="button" class="campaign-editor__button" data-editor-command="align" data-align="left" title="По левому краю" aria-pressed="false">&#8592;</button>
                        <button type="button" class="campaign-editor__button" data-editor-command="align" data-align="center" title="По центру" aria-pressed="false">&#8596;</button>
                        <button type="button" class="campaign-editor__button" data-editor-command="align" data-align="right" title="По правому краю" aria-pressed="false">&#8594;</button>
                        <span class="campaign-editor__separator" aria-hidden="true"></span>
                        <button type="button" class="campaign-editor__button" data-editor-insert-image title="Вставить изображение" aria-pressed="false">Фото</button>
                        <button type="button" class="campaign-editor__button campaign-editor__button--mode" data-editor-toggle-source title="Исходный HTML" aria-pressed="false">HTML</button>
                    </div>
                    <div class="campaign-editor__image-form" data-editor-image-form hidden>
                        <input type="url" class="field__input campaign-editor__image-url" data-editor-image-url placeholder="https://example.com/image.jpg" aria-label="URL изображения">
                        <input type="text" class="field__input campaign-editor__image-alt" data-editor-image-alt placeholder="Alt-текст" aria-label="Alt-текст">
                        <input type="number" class="field__input campaign-editor__image-width" data-editor-image-width placeholder="Ширина, px" min="1" aria-label="Ширина в пикселях">
                        <button type="button" class="btn btn--primary btn--sm" data-editor-image-insert>Вставить</button>
                        <button type="button" class="btn btn--secondary btn--sm" data-editor-image-cancel>Отмена</button>
                        <span class="field__error" data-editor-image-error role="alert" hidden></span>
                    </div>
                    <div class="campaign-editor__surface" data-editor-surface></div>
                    <textarea
                        class="field__input campaign-form__body campaign-editor__source"
                        id="body"
                        name="body"
                        rows="8"
                    >{{ campaign.body|default('') }}</textarea>
                    <span class="field__hint">Токены: {{ '{{' }}greeting{{ '}}' }} — приветствие, {{ '{{' }}organization_name{{ '}}' }} — название организации, {{ '{{' }}contact_name{{ '}}' }} — имя контакта, {{ '{{' }}unsubscribe_url{{ '}}' }} — ссылка для отписки</span>
                    {% if errors.body is defined and errors.body %}
                        <span class="field__error" role="alert">{{ errors.body }}</span>
                    {% endif %}
                    <div class="campaign-editor__preview">
                        {{ include('components/button.html.twig', {
                            variant: 'secondary',
                            sm: true,
                            text: 'Предпросмотр',
                            type: 'button',
                            attr: { 'data-campaign-preview-open': '' },
                        }) }}
                    </div>
                </div>

                <div class="field">
                    <label class="field__label">Вложения</label>
                    {% if attachmentError %}
                        <span class="field__error" role="alert">{{ attachmentError }}</span>
                    {% endif %}
                    {% if isEdit and campaign.attachments is not empty %}
                        <ul class="campaign-form__file-list">
                            {% for attachment in campaign.attachments %}
                                <li class="campaign-form__file-item">
                                    <span class="campaign-form__file-info">
                                        <span class="campaign-form__file-name">{{ attachment.filename }}</span>
                                        {% if attachment.size %}
                                            <span class="campaign-form__file-size">{{ (attachment.size / 1024)|round(1) }} КБ</span>
                                        {% endif %}
                                    </span>
                                    <button type="button" class="btn btn--secondary btn--sm campaign-form__file-remove"
                                        data-action="remove-attachment"
                                        data-url="{{ path('app_campaign_attachment_remove', { id: campaign.id, attachmentId: attachment.id }) }}"
                                        data-csrf="{{ csrf_token('campaign_attachment') }}">Удалить</button>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                    <div class="campaign-form__upload-row">
                        <input type="hidden" name="_attachment_csrf" value="{{ csrf_token('campaign_attachment') }}">
                        <input class="campaign-form__upload-input" type="file" id="attachment" name="attachments[]" multiple>
                    </div>
                    <span class="field__hint">При нажатом Ctrl можно выбрать несколько файлов</span>
                </div>

                <div class="campaign-form__actions">
                    {{ include('components/button.html.twig', {
                        variant: 'primary',
                        text: isEdit ? 'Сохранить' : 'Создать',
                    }) }}
                    {{ include('components/button.html.twig', {
                        variant: 'secondary',
                        text: 'Отмена',
                        href: isEdit ? path('app_campaign_show', { id: campaign.id }) : path('app_campaign_index'),
                        type: 'button',
                    }) }}
                    {% if isEdit %}
                        {{ include('components/button.html.twig', {
                            variant: 'secondary',
                            text: 'Удалить',
                            href: path('app_campaign_delete', { id: campaign.id }),
                            type: 'button',
                        }) }}
                    {% endif %}
                </div>
            </form>
        </div>
    </section>

    {{ include('campaign/_preview_modal.html.twig', {
        livePreviewUrl: path('app_campaign_preview_live'),
    }) }}

    <script>
        (() => {
            document.addEventListener('click', (e) => {
                const btn = e.target.closest('[data-action="remove-attachment"]');
                if (!btn) return;

                const url = btn.dataset.url;
                const csrf = btn.dataset.csrf;

                fetch(url, {
                    method: 'POST',
                    headers: { 'X-CSRF-Token': csrf, 'X-Requested-With': 'XMLHttpRequest' }
                }).then(() => btn.closest('li').remove());
            });

        })();
    </script>
{% endblock %}
