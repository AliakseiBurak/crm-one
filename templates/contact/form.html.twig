{#
    Форма контакта: создание (contact is null) и редактирование
    (change contacts-crud). Поля — компонент form_field и разметка .field
    дизайн-системы (подчёркивание), ошибки валидации — под полем на русском.
    Организация выбирается только при создании (выпадающий список доступных
    организаций); в режиме редактирования она не меняется.
    Ожидает: contact (?Contact), organizations (Organization[]),
    selectedOrganizationId (?int), errors (array<string, string>),
    errorRecipients (CampaignRecipient[]|null).
#}
{% extends 'base.html.twig' %}

{% set isEdit = contact and contact.id %}

{% block title %}{{ isEdit ? 'Редактирование контакта' : 'Новый контакт' }}{% endblock %}

{% block body %}
    <section class="section section--white">
        <div class="container">
            <h1>{{ isEdit ? 'Редактирование контакта' : 'Новый контакт' }}</h1>

            <form
                class="contact-form"
                method="post"
                action="{{ isEdit
                    ? path('app_contact_update', { id: contact.id })
                    : path('app_contact_create') }}"
            >
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('contact') }}">

                {% if isEdit %}
                    {# Организация фиксируется при создании и не меняется #}
                    <div class="field">
                        <label class="field__label" for="organization">Организация</label>
                        <select class="field__input" id="organization" name="organization" disabled>
                            <option value="{{ contact.organization.id }}">{{ contact.organization.name }}</option>
                        </select>
                    </div>
                {% else %}
                    <div class="field">
                        <label class="field__label" for="organization">Организация</label>
                        <select class="field__input" id="organization" name="organization" required data-org-combobox>
                            <option value="">— выберите организацию —</option>
                            {% for organization in organizations %}
                                <option value="{{ organization.id }}"{% if organization.id == selectedOrganizationId %} selected{% endif %}>
                                    {{ organization.name }}
                                </option>
                            {% endfor %}
                        </select>
                        {% if errors.organization|default(null) %}<span class="field__error" role="alert">{{ errors.organization }}</span>{% endif %}
                    </div>
                {% endif %}

                {{ include('components/form_field.html.twig', {
                    name: 'name',
                    label: 'Имя',
                    value: contact.name|default(''),
                    required: true,
                    error: errors.name|default(null),
                }) }}

                {{ include('components/form_field.html.twig', {
                    name: 'phone',
                    label: 'Телефон',
                    type: 'tel',
                    value: contact.phone|default(''),
                    error: errors.phone|default(null),
                }) }}

                {{ include('components/form_field.html.twig', {
                    name: 'email',
                    label: 'Email',
                    type: 'email',
                    value: contact.email|default(''),
                    error: errors.email|default(null),
                }) }}

                {{ include('components/form_field.html.twig', {
                    name: 'position',
                    label: 'Должность',
                    value: contact.position|default(''),
                    error: errors.position|default(null),
                }) }}

                <div class="field">
                    <label class="field__label" for="notes">Заметка</label>
                    <textarea class="field__input" id="notes" name="notes" rows="3">{{ contact.notes|default('') }}</textarea>
                </div>

                {% if isEdit and errorRecipients is defined and errorRecipients|length > 0 %}
                    <div class="contact-form__errors">
                        <h2>Ошибки доставки рассылок</h2>
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Рассылка</th>
                                    <th>Статус</th>
                                    <th>Ошибка</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for recipient in errorRecipients %}
                                    <tr>
                                        <td>{{ recipient.campaign.name }}</td>
                                        <td>
                                            {% if recipient.status.value == 'failed' %}
                                                <span class="campaign-recipients__status campaign-recipients__status--failed">Ошибка</span>
                                            {% elseif recipient.status.value == 'bounced' %}
                                                <span class="campaign-recipients__status campaign-recipients__status--bounced">Отказ</span>
                                            {% endif %}
                                            {% if recipient.status.value == 'failed' %}
                                                <button type="button" class="campaign-recipients__reset-btn" title="Сбросить"
                                                    data-action="reset-recipient"
                                                    data-url="{{ path('app_campaign_recipient_reset', { id: recipient.campaign.id, recipientId: recipient.id }) }}"
                                                    data-csrf="{{ csrf_token('campaign_recipient') }}">✕</button>
                                            {% elseif recipient.status.value == 'bounced' %}
                                                <a href="{{ path('app_campaign_recipient_reset_confirm', { id: recipient.campaign.id, recipientId: recipient.id }) }}" class="campaign-recipients__reset-btn" title="Сбросить">✕</a>
                                            {% endif %}
                                        </td>
                                        <td>{{ recipient.errorMessage|default('') }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}

                {% if isEdit %}
                    <div class="contact-form__org-link" style="margin-top: 24px;">
                        {{ include('components/button.html.twig', {
                            variant: 'secondary',
                            text: 'Организация',
                            href: path('app_organization_edit', { id: contact.organization.id }),
                            type: 'button',
                        }) }}
                    </div>
                {% endif %}

                <div class="organization-form__actions">
                    {{ include('components/button.html.twig', {
                        variant: 'primary',
                        text: isEdit ? 'Сохранить' : 'Создать',
                    }) }}
                    {{ include('components/button.html.twig', {
                        variant: 'secondary',
                        text: 'Отмена',
                        href: path('app_dashboard'),
                        type: 'button',
                    }) }}
                    {% if isEdit %}
                        {{ include('components/button.html.twig', {
                            variant: 'secondary',
                            text: 'Удалить',
                            href: path('app_contact_delete', { id: contact.id }),
                            type: 'button',
                            attr: { class: 'contact-form__delete' },
                        }) }}
                    {% endif %}
                </div>
            </form>
        </div>
    </section>

    <script>
        document.addEventListener('click', (e) => {
            const btn = e.target.closest('[data-action="reset-recipient"]');
            if (!btn) return;
            if (!confirm('Сбросить статус получателя?')) return;
            fetch(btn.dataset.url, {
                method: 'POST',
                headers: { 'X-CSRF-Token': btn.dataset.csrf, 'X-Requested-With': 'XMLHttpRequest' }
            }).then(() => btn.closest('tr')?.remove());
        });
    </script>
{% endblock %}
